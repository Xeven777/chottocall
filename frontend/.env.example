# ChottoCall frontend env (copy to .env.local)
# Only NEXT_PUBLIC_* vars are exposed to the browser.

# Base URL of the FastAPI backend; the client POSTs to ${NEXT_PUBLIC_API_URL}/api/offer
# Next.js inlines this at build time. For Docker, set the `NEXT_PUBLIC_API_URL`
# build arg in docker-compose.yml instead of editing .env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
