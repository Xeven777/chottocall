# ChottoCall backend env (copy to .env at the repo root)
# The backend loads this file automatically via python-dotenv (find_dotenv),
# so just run uvicorn from backend/ and these values apply.

# --- LLM ---
# Comma-separated preference chain, first reachable provider wins. Groq is
# appended automatically when missing, so a local-only setting still never
# leaves a call without an LLM. Providers: llama.cpp | ollama | groq.
LLM_PROVIDER=llama.cpp,ollama,groq

# llama.cpp OpenAI-compatible server. LLAMA_CPP_MODEL must be an id from
# GET ${LLAMA_CPP_BASE_URL}/models - either the path llama.cpp loaded, or the
# --alias you gave it:
#   llama serve -m model.gguf --port 8080 --alias sarvam-30b
# No --alias => the id is the model path, e.g. /tmp/llama_workspace/model/model.gguf
LLAMA_CPP_BASE_URL=http://localhost:8080/v1
LLAMA_CPP_MODEL=sarvam-30b
# Seconds to wait for GET /v1/models on the local server before falling back to
# Groq. Raise it for a tunnel/remote host (1s was too short for cloudflared).
LLM_PROBE_TIMEOUT=15
# Cap on generated tokens per turn. A spoken reply is 1-2 sentences; without a
# cap a reasoning-capable model can generate thousands of tokens (45s+ at
# ~70 tok/s) for text nobody ever hears.
LLM_MAX_TOKENS=256

# Ollama fallback (model auto-discovered when empty/unavailable)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:1b

# Groq cloud fallback (used when the local server is down)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- STT ---
# Providers: shruti (local Bengali). The weights path is relative to backend/.
STT_PROVIDER=shruti
SHRUTI_WEIGHTS=models/shruti-bengali.cact

# --- TTS ---
# Comma-separated preference chain; the next provider speaks a sentence the
# first one failed to synthesize. Providers: tiny-swara (local ONNX, default) |
# mithi (local) | speechify (hosted).
TTS_PROVIDER=tiny-swara,mithi,speechify

# Local tiny-swara: copy the self-contained model folder here (models/ is
# gitignored). Needs espeak-ng on PATH; onnxruntime comes with pipecat's silero extra.
#   cp -r /path/to/tiny-swara/tiny-swara-hf/. backend/models/tiny-swara/
TTS_TINY_SWARA_DIR=models/tiny-swara
# Empty = inference.py picks onnx/tiny-swara-int8.onnx, then the FP32 model.
TTS_TINY_SWARA_MODEL=
TTS_TINY_SWARA_VOICE=BF               # BF (female) | BM (male)
TTS_TINY_SWARA_SPEED=1.0

# Mithi is skipped entirely when the model directory has no run.py, so a
# machine without the 199 MB model never loads torch. Leave Speechify's key
# empty if you don't want a hosted fallback at all.
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE=ritwik
SPEECHIFY_MODEL=simba-3.5
SPEECHIFY_LANGUAGE=bn-IN

# Local Mithi v2 Flash. Installed by the normal `uv sync` in backend/.
# and download with: uv run hf download Oomni/mithi-v2-flash --local-dir models/mithi-v2-flash
TTS_MITHI_MODEL_DIR=models/mithi-v2-flash
TTS_MITHI_VOICE=satvik            # satvik anirban nakul vasant siddhant (male); charvi ahana vaidehi malini jahnavi (female)
TTS_MITHI_LANG=bn                 # bn= Bengali, en= English, + 9 other Indian languages
TTS_MITHI_DEVICE=auto             # auto | xpu (Intel Arc) | cpu | cuda
TTS_MITHI_THREADS=0               # CPU threads; 0 = let PyTorch choose (4 is a good starting point)

# --- Voice pipeline ---
# 1 = mic stays open while the bot speaks (barge-in); 0 = half-duplex
CHOTTO_BARGE_IN=0

# Voice activity detection: silero (bundled ONNX, no API key)
VAD_PROVIDER=silero

# Turn detection: smart_turn (local SmartTurn v3, default) | speech_timeout
# (fixed silence window, no model load). stop_timeout_s is how long the bot
# waits for a turn to be declared before giving up.
TURN_PROVIDER=smart_turn
TURN_STOP_TIMEOUT=5.0
TURN_IDLE_TIMEOUT=0.0

# --- Legacy / unused ---
ELEVENLABS=
